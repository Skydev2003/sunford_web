generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  commercial
  industrial
  food
  smart
  pos
  laboratory
  accessories
  lifestyle
}

model Product {
  id             String          @id
  slug           String          @unique
  name           String
  category       ProductCategory
  categoryId     String?
  subtitle       String
  description    String
  image          String
  capacity       String
  readability    String
  connection     String
  badge          String?
  featured       Boolean         @default(false)
  published      Boolean         @default(true)
  sortOrder      Int             @default(0)
  // Existing seed rows retain their pre-import public presentation until edited.
  catalogManaged Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([published, sortOrder])
  @@index([category])
  @@map("products")
}

// Overrides keep the imported catalogue and pages intact as fallback content.
model CmsDocument {
  id        String    @id
  kind      String
  data      Json
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([kind, deletedAt])
  @@map("cms_documents")
}

// Foreign key to auth.users is maintained in the SQL migration, outside Prisma's public schema.
model AdminUser {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model HomepageImage {
  slot            String   @id
  image           String
  // Stable product identity, resolved against published products at render time.
  targetProductId String?
  targetPagePath  String?
  updatedAt       DateTime @updatedAt

  @@index([image])
  @@map("homepage_images")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  title      String
  actorId    String
  actorEmail String
  fields     String[]
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
