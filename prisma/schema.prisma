generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  commercial
  industrial
  food
  smart
  pos
  laboratory
  accessories
  lifestyle
}

model Product {
  id             String          @id
  slug           String          @unique
  name           String
  category       ProductCategory
  subtitle       String
  description    String
  image          String
  capacity       String
  readability    String
  connection     String
  badge          String?
  featured       Boolean         @default(false)
  published      Boolean         @default(true)
  sortOrder      Int             @default(0)
  // Existing seed rows retain their pre-import public presentation until edited.
  catalogManaged Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([published, sortOrder])
  @@index([category])
  @@map("products")
}

// Foreign key to auth.users is maintained in the SQL migration, outside Prisma's public schema.
model AdminUser {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model HomepageImage {
  slot      String   @id
  image     String
  updatedAt DateTime @updatedAt

  @@index([image])
  @@map("homepage_images")
}
