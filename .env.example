# Optional separate quotation-number registry, not CMS or product content.
# Required by quotation issuance in production; never point Prisma at Warehouse.
DATABASE_URL=""
DIRECT_URL=""

# Independent Warehouse PostgreSQL connection (use an account with SELECT only).
WAREHOUSE_DATABASE_URL="postgresql://READ_USER:URL_ENCODED_PASSWORD@WAREHOUSE_HOST:5432/WAREHOUSE_DB"
WAREHOUSE_COMPANY_ID="1"

# Existing Warehouse object storage; needed for changed/new product photos.
WAREHOUSE_S3_ENDPOINT=""
WAREHOUSE_S3_BUCKET=""
WAREHOUSE_S3_REGION=""
WAREHOUSE_S3_KEY=""
WAREHOUSE_S3_SECRET=""
