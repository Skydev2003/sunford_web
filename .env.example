# Replace YOUR-PASSWORD with the URL-encoded database password. Never commit .env.
# Runtime: Supavisor transaction pooler.
# Separate server-only Warehouse HTTP API origin for SKUs and net selling prices.
WAREHOUSE_API_URL=""
DATABASE_URL="postgresql://postgres.crombyjxorqcrfbisqzh:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Prisma CLI / migrations: session pooler (verify this endpoint in Supabase Connect).
DIRECT_URL="postgresql://postgres.crombyjxorqcrfbisqzh:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Optional: retain the project URL when existing images use Supabase Storage.
SUPABASE_URL="https://crombyjxorqcrfbisqzh.supabase.co"

# Server-only origin of the Warehouse service that serves GET /api/store/products.
# Supply the verified API origin (scheme + hostname + optional port), not a DB URL.
# Keep DATABASE_URL pointed at the website/CMS PostgreSQL database above.
# See docs/warehouse/local-env-setup.md. The provided public www.sunford.co route returned 404.
WAREHOUSE_API_URL=""

# Vercel: add DATABASE_URL to each target; SUPABASE_URL is optional for stored images.
# Add DIRECT_URL to Production only; Preview never migrates/seeds during builds.
# Use a separate Supabase project for Preview; prepare its schema/catalogue beforehand.
# APP_ENV is inferred from VERCEL_ENV (production -> production, preview -> uat).
# If explicitly set in Vercel, scope APP_ENV=production to Production and APP_ENV=uat to Preview.
# Do not set VERCEL_* yourself; enable System Environment Variables in Vercel.
