# Website-only writable registry in Warehouse: ecommerce.quotation_issues.
# Required in production; use a direct/session connection and a scoped writer.
# db:deploy sets up only this table, never the historical CMS migrations.
QUOTATION_DATABASE_URL=""

# Independent Warehouse PostgreSQL connection (use an account with SELECT only).
WAREHOUSE_DATABASE_URL="postgresql://READ_USER:URL_ENCODED_PASSWORD@WAREHOUSE_HOST:5432/WAREHOUSE_DB"
WAREHOUSE_COMPANY_ID="1"

# Existing Warehouse object storage; needed for changed/new product photos.
WAREHOUSE_S3_ENDPOINT=""
WAREHOUSE_S3_BUCKET=""
WAREHOUSE_S3_REGION=""
WAREHOUSE_S3_KEY=""
WAREHOUSE_S3_SECRET=""
